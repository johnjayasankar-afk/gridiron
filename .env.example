# Gridiron · every setting, with its default.
#
# Every one of these is optional: with none of them set, the server runs on
# port 8787 against ESPN's public endpoints and needs no credentials at all.
# Copy what you need into .env.local, which is Git-ignored. Keys belong in
# server environment variables or that file, and are never sent to the browser.

# ── the server ──────────────────────────────────────────────────────────────
# HTTP port.
PORT=8787
# Bind address. Defaults to 0.0.0.0 when NODE_ENV=production, 127.0.0.1 otherwise.
HOST=127.0.0.1
# Built client to serve. `none` serves the API only.
GRIDIRON_STATIC_DIR=dist
# Keeps discovered college divisions, the generated push keys and push
# subscriptions between restarts. `off` disables it. On a host with ephemeral
# storage, put this on a volume or set the VAPID pair below instead: losing the
# keys stops every existing push subscription working.
GRIDIRON_CACHE_DIR=.cache
# `1` behind a reverse proxy that sets x-forwarded-for, so rate limits see each
# visitor rather than the proxy.
GRIDIRON_TRUST_PROXY=

# ── where the data comes from ───────────────────────────────────────────────
# `espn` (default), `sportradar` for the licensed adapter, or `replay` to serve
# a captured scenario as the default source.
GRIDIRON_PROVIDER=espn
# Scenario for GRIDIRON_PROVIDER=replay.
GRIDIRON_REPLAY_SCENARIO=nfl-week1-sunday
# Captured responses the replay lab reads.
GRIDIRON_FIXTURES_DIR=fixtures/espn
# Saved team documents the replay lab reads before the network.
GRIDIRON_TEAM_FIXTURES_DIR=fixtures/espn/team

# ── asking the provider ─────────────────────────────────────────────────────
# Per-request provider timeout, in milliseconds.
GRIDIRON_FETCH_TIMEOUT_MS=9000
# Concurrent provider requests.
GRIDIRON_FETCH_CONCURRENCY=6
# Provider requests per minute. Counted per process: see the note on the fetch
# budget in the README, which explains what that means on a serverless host.
GRIDIRON_FETCH_BUDGET=150
# Polling intervals in seconds; see the README for each GRIDIRON_POLL_* name.

# ── limits ──────────────────────────────────────────────────────────────────
# Concurrent browser streams.
GRIDIRON_MAX_STREAMS=500
# Concurrent replay lab sessions. `0` disables the lab.
GRIDIRON_MAX_REPLAY_SESSIONS=25

# ── what is switched on ─────────────────────────────────────────────────────
# `off` turns Kalshi market prices off.
GRIDIRON_MARKETS=on
# `off` turns push alerts off.
GRIDIRON_PUSH=on

# ── push alerts ─────────────────────────────────────────────────────────────
# The push key pair. Leave both unset to generate a pair once into the cache
# directory. Set them here to survive a host with no persistent storage.
GRIDIRON_VAPID_PUBLIC_KEY=
GRIDIRON_VAPID_PRIVATE_KEY=
# An https: URL or mailto: address a push service can use to reach whoever runs
# this server.
GRIDIRON_VAPID_SUBJECT=https://labs.johnjayasankar.com/

# ── the licensed provider ───────────────────────────────────────────────────
# Keys and settings for GRIDIRON_PROVIDER=sportradar. See docs/PROVIDERS.md.
# The adapter is written but has never run against a real key: the README says
# so, and so does this file.
SPORTRADAR_API_KEY=
SPORTRADAR_NFL_ACCESS=
SPORTRADAR_NCAAFB_ACCESS=

# ── development and tests only ──────────────────────────────────────────────
# Tells the Vite dev server where to send /api.
GRIDIRON_API=http://127.0.0.1:8787
# Lets a replay-only server send push alerts, each titled "Replay".
GRIDIRON_PUSH_REPLAY=
# Admits a local test push service outside production.
GRIDIRON_PUSH_ALLOW_HOSTS=
